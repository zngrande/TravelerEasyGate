+}
+.dtp-cal-head .dtp-nav:hover { background: #f1f5f9; color: var(--primary-blue, #2563eb); }
+.dtp-cal-head .dtp-title {
+    font-size: 14px; font-weight: 700; color: var(--text-dark, #1e293b);
+    cursor: pointer; padding: 2px 8px; border-radius: 6px;
+}
+.dtp-cal-head .dtp-title:hover { background: #f1f5f9; }
+.dtp-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
+.dtp-cal-grid .dtp-dow {
+    font-size: 11px; font-weight: 700; color: var(--text-gray, #64748b); text-align: center; padding: 4px 0 8px;
+}
+.dtp-cal-grid .dtp-day {
+    aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
+    font-size: 13px; font-weight: 600; color: var(--text-dark, #1e293b); border-radius: 8px;
+    cursor: pointer; border: none; background: transparent; font-variant-numeric: tabular-nums;
+}
+.dtp-cal-grid .dtp-day:hover:not(.dtp-empty):not(.dtp-selected) { background: #eff6ff; }
+.dtp-cal-grid .dtp-day.dtp-empty { cursor: default; }
+.dtp-cal-grid .dtp-day.dtp-outside { color: #cbd5e1; }
+.dtp-cal-grid .dtp-day.dtp-today:not(.dtp-selected) { box-shadow: inset 0 0 0 1.5px var(--primary-blue, #2563eb); color: var(--primary-blue, #2563eb); }
+.dtp-cal-grid .dtp-day.dtp-selected { background: var(--primary-blue, #2563eb); color: #fff; }
+
+/* 月/年快速選擇 (點標題切換進來的第二層) */
+.dtp-cal-grid.dtp-months, .dtp-cal-grid.dtp-years { grid-template-columns: repeat(3, 1fr); gap: 6px; }
+.dtp-cal-grid.dtp-months .dtp-cell, .dtp-cal-grid.dtp-years .dtp-cell {
+    padding: 10px 4px; text-align: center; font-size: 13px; font-weight: 600; color: var(--text-dark, #1e293b);
+    border-radius: 8px; cursor: pointer; border: none; background: transparent;
+}
+.dtp-cal-grid.dtp-months .dtp-cell:hover, .dtp-cal-grid.dtp-years .dtp-cell:hover { background: #eff6ff; }
+.dtp-cal-grid.dtp-months .dtp-cell.dtp-selected, .dtp-cal-grid.dtp-years .dtp-cell.dtp-selected { background: var(--primary-blue, #2563eb); color: #fff; }
+
+.dtp-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border-color, #e2e8f0); }
+.dtp-footer button {
+    font-size: 12.5px; font-weight: 700; border: none; background: transparent; cursor: pointer; padding: 5px 8px; border-radius: 6px;
+}
+.dtp-footer .dtp-today-btn { color: var(--primary-blue, #2563eb); }
+.dtp-footer .dtp-today-btn:hover { background: #eff6ff; }
+.dtp-footer .dtp-clear-btn { color: var(--text-gray, #64748b); }
+.dtp-footer .dtp-clear-btn:hover { background: #f1f5f9; color: #dc2626; }
+
+/* ---------- 時間面板 ---------- */
+.dtp-panel.dtp-time { width: 200px; padding: 10px; }
+.dtp-time-cols { display: flex; gap: 8px; height: 220px; }
+.dtp-time-col { flex: 1; overflow-y: auto; scroll-behavior: smooth; border-radius: 8px; background: #f8fafc; padding: 4px; }
+.dtp-time-col::-webkit-scrollbar { width: 5px; }
+.dtp-time-col::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
+.dtp-time-col .dtp-time-cell {
+    text-align: center; padding: 7px 0; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums;
