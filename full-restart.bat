@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

cd /d "%~dp0"

echo ============================================
echo   Useful Travel - 完整重啟
echo ============================================
echo.
echo 提醒: 如果你有另外開著 watch-and-compile.bat 的視窗,
echo       請先手動關掉它, 這個腳本不會幫你關掉那個視窗。
echo.
pause

REM ------------------------------------------------------------
REM 1) 找出佔用 8080 port 的程式並強制關閉
REM    (確保舊的伺服器程序真的結束, 不會殘留舊版程式碼繼續在跑)
REM ------------------------------------------------------------
echo [1/3] 檢查並關閉佔用 8080 port 的程式...
set FOUND=0
for /f "tokens=5" %%p in ('netstat -ano ^| findstr :8080 ^| findstr LISTENING') do (
    echo   發現 PID %%p 正在佔用 8080, 強制關閉...
    taskkill /F /PID %%p >nul 2>&1
    set FOUND=1
)
if !FOUND!==0 (
    echo   目前沒有程式佔用 8080, 跳過。
)
timeout /t 2 /nobreak >nul

REM ------------------------------------------------------------
REM 2) 完整重新編譯 (不加 -o, 確保抓到最新原始碼跟相依套件)
REM ------------------------------------------------------------
echo.
echo [2/3] 完整重新編譯中 (mvnw.cmd clean install)...
echo ----------------------------------------------
call mvnw.cmd clean install
if errorlevel 1 (
    echo.
    echo ============================================
    echo   [錯誤] 編譯失敗, 請往上捲看紅字錯誤訊息。
    echo ============================================
    pause
    exit /b 1
)

REM ------------------------------------------------------------
REM 3) 啟動程式
REM ------------------------------------------------------------
echo.
echo [3/3] 編譯成功, 啟動程式中...
echo ============================================
call mvnw.cmd spring-boot:run

echo.
echo ============================================
echo   程式已結束 (若是錯誤結束, 請往上捲看錯誤訊息)
echo ============================================
pause