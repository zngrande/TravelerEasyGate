+    // 篩選：用名稱/國家/地區即時過濾下面的行程表格 (純前端, 不用重新整理頁面)
+    function filterItineraries() {
+        const keyword = document.getElementById('itineraryFilterInput').value.trim().toLowerCase();
+        document.querySelectorAll('.table-container tbody tr').forEach(function (row) {
+            const haystack = [row.dataset.title, row.dataset.country, row.dataset.region]
+                .filter(Boolean).join(' ').toLowerCase();
+            row.style.display = (!keyword || haystack.indexOf(keyword) !== -1) ? '' : 'none';
+        });
+    }
+
+    // 釘選 / 取消釘選：呼叫後端切換狀態，成功後直接重新整理頁面讓釘選的行程排到最上面
+    // (排序邏輯在後端 SQL 做, 前端不用自己重新排列 DOM 順序, 比較不容易跟資料庫狀態兜不起來)
+    function togglePin(ITID) {
+        fetch('/itinerary/' + ITID + '/pin', { method: 'POST' })
+            .then(function (res) {
+                if (!res.ok) throw new Error('切換釘選狀態失敗');
+                return res.json();
+            })
+            .then(function () { window.location.reload(); })
+            .catch(function (err) { alert(err.message || '操作失敗，請稍後再試'); });
+    }
+
+    // 往右滑釘選 (仿 LINE 聊天列表)：手指在行程名稱那一格往右拖曳，超過門檻放開就觸發釘選/取消釘選；
+    // 沒超過門檻就彈回原位，不會誤觸。用 pointer events 同時支援觸控螢幕跟滑鼠拖曳。
+    (function initSwipeToPin() {
+        const SWIPE_THRESHOLD = 60; // 拖曳超過這個距離 (px) 放開才算觸發
+        const MAX_DRAG = 90; // 拖曳最多允許移動這麼多 px, 避免整格被拖出畫面外
+
+        document.querySelectorAll('.swipe-content').forEach(function (content) {
+            const ITID = content.dataset.itid;
+            let startX = null;
+            let dragging = false;
+
+            function onPointerDown(e) {
+                startX = e.clientX;
+                dragging = true;
+                content.style.transition = 'none';
+            }
+
+            function onPointerMove(e) {
+                if (!dragging || startX === null) return;
+                const delta = Math.max(0, Math.min(MAX_DRAG, e.clientX - startX)); // 只允許往右滑
+                content.style.transform = 'translateX(' + delta + 'px)';
+                const hint = content.parentElement.querySelector('.swipe-hint');
+                if (hint) hint.style.opacity = String(Math.min(1, delta / SWIPE_THRESHOLD));
+            }
+
+            function onPointerUp(e) {
+                if (!dragging || startX === null) return;
+                dragging = false;
+                content.style.transition = 'transform 0.2s ease';
+                const delta = Math.max(0, Math.min(MAX_DRAG, (e.clientX || startX) - startX));
+                content.style.transform = 'translateX(0)';
+                const hint = content.parentElement.querySelector('.swipe-hint');
+                if (hint) hint.style.opacity = '0';
+                startX = null;
+                if (delta >= SWIPE_THRESHOLD) togglePin(ITID);
+            }
+
+            content.addEventListener('pointerdown', onPointerDown);
+            content.addEventListener('pointermove', onPointerMove);
+            content.addEventListener('pointerup', onPointerUp);
+            content.addEventListener('pointercancel', onPointerUp);
+        });
+    })();
 </script>
 
