原本項目內拖曳排序是拖完立即打 API 存檔, 跟頁面上其他編輯(欄位修改/刪除/Day
分頁順序)的「先暫存, 按儲存編輯才送出」不一致, 使用者可能手滑拖曳就直接洗掉
資料庫裡的舊順序、也沒有上一步可以復原。

改成新增 pendingItemOrder (idid -> 暫存的新 IIID 順序) 狀態, 拖曳排序時只更新
這個變數並呼叫 markDirty(), 不打 API; buildDisplayItems() 套用暫存順序讓畫面
即時反映; 存檔時 saveAllChanges() 依序把每個有異動的 idid 送到既有的
/itinerary/day/{idid}/reorder API。

代價: 拉車距離/時間的重新計算需要後端算法, 沒辦法在瀏覽器端假算, 所以存檔前
清單上顯示的公里數/分鐘數會維持拖曳前的舊數字, 因此加了一個提示 banner 告知
使用者「順序已變更(尚未儲存)」。
---
 .../resources/templates/itinerary/board.html  | 84 ++++++++++++-------
 1 file changed, 54 insertions(+), 30 deletions(-)

diff --git a/src/main/resources/templates/itinerary/board.html b/src/main/resources/templates/itinerary/board.html
index c3ad5f4..1fb7fe5 100644
--- a/src/main/resources/templates/itinerary/board.html
+++ b/src/main/resources/templates/itinerary/board.html
@@ -1075,13 +1075,15 @@
     // 真正送到後端存檔是按下「儲存編輯」按鈕時才會一次送出 (見 saveAllChanges())。
     // 新增項目 (從 景點資料庫加入 / 自訂項目 / 加入景點資料庫 / 切換候選點 / 切換交通方式 / 自動整理 / 上傳圖片)
     // 因為牽涉到後端的地理定位、多候選點拆解等邏輯，維持「立即存檔」，不會被暫存機制擋住。
-    // 項目內的拖曳排序也一樣改成「立即存檔」了 (見 renderDay 的 Sortable onEnd) —— 因為排序牽涉到重新計算
-    // 拉車距離/時間, 沒辦法只在瀏覽器裡假裝算出來, 只有 Day 分頁的順序 (pendingDayOrder) 還維持暫存機制,
-    // 因為那個純粹是顯示順序, 不影響任何距離/時間計算。
+    // 項目內的拖曳排序 (pendingItemOrder) 也改成跟其他編輯一樣先暫存, 要按「儲存編輯」才會真的存進資料庫、
+    // 「上一步」/離開畫面不儲存也能正確復原——這是刻意的取捨: 拉車距離/時間要等存檔後重新整理才會用新順序
+    // 重算 (儲存前地圖跟路線提示文字暫時還是舊順序的數字, 畫面上會用一個小提示告知使用者), 換來的是排序
+    // 這個動作能跟其他編輯一樣, 有清楚的「儲存前可以隨時放棄」保護, 不會拖曳完手滑就直接洗掉資料庫舊順序。
     let dayCache = {};        // idid -> { items, routes, optionsMap } 最近一次從後端抓到的原始資料
     let pendingEdits = {};    // iiid -> { customName, stayDurationMin, locationHint, note, showOnMap, description, descriptionPid }
     let pendingDeletes = new Set(); // 已標記移除、還沒送出的 iiid
     let pendingDayOrder = null; // 拖拉 Day 分頁後的新 IDID 順序, null 代表天數順序沒有異動
+    let pendingItemOrder = {};  // idid -> 拖拉這一天項目順序後的新 IIID 陣列, 這個 idid 沒有 key 代表這天順序沒有異動
     let hasUnsavedChanges = false;
 
     function markDirty() {
@@ -1121,13 +1123,25 @@
         if (hasUnsavedChanges) { e.preventDefault(); e.returnValue = ''; }
     });
 
-    // 依目前的 pendingEdits / pendingDeletes, 把某一天「畫面上應該顯示的項目清單」算出來
-    // (排序已經是伺服器上的真實順序, 因為拖曳排序改成立即存檔了, 不用再套用任何暫存的順序)
+    // 依目前的 pendingEdits / pendingDeletes / pendingItemOrder, 把某一天「畫面上應該顯示的項目清單」算出來
     function buildDisplayItems(idid) {
         const raw = (dayCache[idid] && dayCache[idid].items) || [];
-        return raw
+        let items = raw
             .filter(it => !pendingDeletes.has(it.IIID))
             .map(it => pendingEdits[it.IIID] ? Object.assign({}, it, pendingEdits[it.IIID]) : it);
+
+        // 這一天有暫存中、還沒儲存的拖曳排序的話, 依那個順序重新排列 (拖曳當下還沒被刪除的項目才會出現在
+        // pendingItemOrder 裡; 萬一有遺漏或對不上的項目 (理論上不會發生, 保險起見), 照原順序接在後面)
+        const order = pendingItemOrder[idid];
+        if (order) {
+            const byId = new Map(items.map(it => [it.IIID, it]));
+            const ordered = order.filter(iiid => byId.has(iiid)).map(iiid => byId.get(iiid));
+            const orderedIds = new Set(order);
+            const leftover = items.filter(it => !orderedIds.has(it.IIID));
+            items = ordered.concat(leftover);
+        }
+
+        return items;
     }
 
     function findDayOfItem(iiid) {
@@ -1191,6 +1205,15 @@
             emptyHint.style.display = 'none';
         }
 
+        // 這天有拖曳後還沒存檔的新排序時, 提醒使用者下面的公里數/分鐘數還是拖曳前的舊數字,
+        // 存檔後才會用新順序重新算 (跟其他暫存中的編輯一樣, 按「上一步」也能放棄這個排序)
+        if (pendingItemOrder[idid]) {
+            const orderHint = document.createElement('div');
+            orderHint.style.cssText = 'display:flex;align-items:center;gap:8px;padding:8px 16px;margin-bottom:8px;font-size:12.5px;color:#92400e;background:#fffbeb;border:1px dashed #fcd34d;border-radius:12px;';
+            orderHint.innerHTML = `<span>⚠️</span><span>順序已變更（尚未儲存）：下方的公里數／分鐘數要按「儲存編輯」後才會依新順序重新計算。</span>`;
+            list.appendChild(orderHint);
+        }
+
         // 前一天最後一項如果是住宿, 顯示成一列淡色的提示卡片放在今天清單最前面, 當作今天的預設出發點
         // (不是今天真正的行程項目, 沒有編輯/移除按鈕; 後面接著它到今天第一個項目的拉車距離/時間, 可以切換走路/開車)
         const carryOverHotel = dayCache[idid] && dayCache[idid].carryOverHotel;
@@ -1408,33 +1431,18 @@
             }
         });
 
-        // 啟用拖曳排序: 拖完立即存檔並重新抓最新資料 (不再是「按儲存編輯」才送出, 見下面 onEnd 裡的說明)
+        // 啟用拖曳排序: 拖完只先暫存新順序到 pendingItemOrder, 不打 API, 要按「儲存編輯」才會真的送出存檔
+        // (跟其他編輯一樣可以隨時「上一步」放棄; 代價是拉車距離/時間會停在拖曳前的舊數字, 直到存檔後才重新整理算出新的,
+        // 所以下面 renderDay 會在這天有暫存排序時顯示一個小提示告知使用者, 見 buildDisplayItems 開頭的說明)
         if (list._sortable) list._sortable.destroy();
         list._sortable = new Sortable(list, {
             animation: 150,
-            onEnd: async (evt) => {
+            onEnd: (evt) => {
                 if (evt.oldIndex === evt.newIndex) return;
                 const newOrder = Array.from(list.querySelectorAll('.item-row')).map(el => parseInt(el.dataset.iiid));
-
-                // 拖曳排序牽涉到重新計算拉車距離/時間 (跟新增項目一樣要打後端 API 才查得到真實數字, 沒辦法只在瀏覽器裡
-                // 假裝算出來), 所以改成拖完立即存檔, 不再是「按儲存編輯」才送出 —— 這樣左側清單的公里數/分鐘數
-                // 才能跟著新順序一起更新, 不會停在拖曳前的舊數字, 地圖也會用重新算好的路線畫。
-                list.style.pointerEvents = 'none';
-                try {
-                    const res = await fetch(`/itinerary/day/${idid}/reorder`, {
-                        method: 'POST',
-                        headers: { 'Content-Type': 'application/json' },
-                        body: JSON.stringify({ order: newOrder })
-                    });
-                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
-                    await fetchDay(idid);
-                    renderDay(idid);
-                } catch (err) {
-                    alert('排序失敗，請稍後再試：' + err.message);
-                    renderDay(idid); // 復原成伺服器上原本的順序
-                } finally {
-                    list.style.pointerEvents = '';
-                }
+                pendingItemOrder[idid] = newOrder;
+                markDirty();
+                renderDay(idid); // 重畫讓清單套用 buildDisplayItems 的新順序, 並顯示「順序已變更」提示
             }
         });
 
@@ -1990,7 +1998,8 @@
     // 從「推薦這中間順路的景點/餐廳」面板按下＋加入時用這個, 跟 addToCurrentDay 的差別是:
     // 後端 addItem 預設一律把新項目加到當天最後面 (sort_order = 目前最大值 + 1), 所以這裡在新增成功、
     // 拿到新項目的 IIID 之後, 再組一份「把新項目插到 fromIIID 跟 toIIID 中間」的順序, 立即存檔
-    // (跟拖曳排序一樣改成立即存檔, 而不是先暫存等按「儲存編輯」, 這樣路程距離/時間才能馬上算出新的數字)。
+    // (這裡是「新增項目」流程的一部分, 跟本來就維持立即存檔的新增邏輯走同一條路; 跟使用者直接拖曳既有項目
+    // 排序 [pendingItemOrder, 先暫存等按「儲存編輯」] 是兩件不同的事, 不要混為一談)。
     function addSuggestedBetween(idid, fromIIID, toIIID, pid, name, itemType) {
         const params = new URLSearchParams({ PID: pid, itemType, customName: name });
         fetch(`/itinerary/day/${idid}/items?` + params.toString(), { method: 'POST' })
@@ -2293,7 +2302,20 @@
                 }
             }
 
-            // 3) 送出 Day 分頁的新順序 (項目內的排序已經改成拖曳時立即存檔, 這裡不用再處理, 見 renderDay 的 Sortable onEnd)
+            // 3) 送出天內項目的新排序 (每個有異動過排序的 idid 各呼叫一次既有的 reorder API;
+            //    要濾掉已經在這次一起被刪除的項目, 不然送出去的順序裡會有後端已經不認得的 IIID)
+            for (const key of Object.keys(pendingItemOrder)) {
+                const idid = Number(key);
+                const order = pendingItemOrder[key].filter(iiid => !pendingDeletes.has(iiid));
+                const res = await fetch(`/itinerary/day/${idid}/reorder`, {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
