+
+            // 4) 送出 Day 分頁的新順序
             const dayOrderChanged = pendingDayOrder != null;
             if (dayOrderChanged) {
                 const res = await fetch(`/itinerary/${itineraryId}/reorder-days`, {
@@ -2308,11 +2330,13 @@
             const affectedDays = new Set();
             for (const iiid of pendingDeletes) { const d = findDayOfItem(iiid); if (d != null) affectedDays.add(d); }
             for (const key of Object.keys(pendingEdits)) { const d = findDayOfItem(Number(key)); if (d != null) affectedDays.add(d); }
+            for (const key of Object.keys(pendingItemOrder)) { affectedDays.add(Number(key)); }
 
             // 清空暫存狀態
             pendingEdits = {};
